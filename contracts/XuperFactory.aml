// XuperFactory: deploys a linked Xcollection v3 + Xlist pair in one tx.
// The xlist is deployed and linked here, never supplied by the caller.
// The platform wallet is read from state, never from the caller.
// Embeds the xholder Xcollection_v3.
// create_collection takes a launch fee, held here until withdraw sends it to the platform wallet.
//
// create_collection >> name, symbol, unrevealed_uri, max_supply, royalty_bps, max_per_wallet,
//                      creator, xpectra, gtd_wallet_cap, fcfs_wallet_cap, public_wallet_cap

contract XuperFactory {

  const XCOLLECTION_BYTECODE: string = ""
  const XLIST_BYTECODE: string = ""

  state {
    owner:           address
    platform_wallet: address
    count:           u128
    launch_fee:      u128
    fee_balance:     u128
    collections:     map[u128]address
    xlists:          map[u128]address
    xlist_of:        map[address]address
  }

  constructor() {
    self.owner = caller
    self.platform_wallet = caller
    self.count = 0
    self.launch_fee = 1000000
    self.fee_balance = 0
  }

  private fn only_owner() {
    require(caller == self.owner, "xuperfactory: not owner")
  }

  // permissionless: any creator deploys their own pair, signing and paying from their own wallet.
  // the factory grants no privilege: it deploys the two contracts, hands ownership to creator, and keeps only the launch fee.
  fn create_collection(
    name:               string,
    symbol:             string,
    unrevealed_uri:     string,
    max_supply:         u128,
    royalty_bps:        u128,
    max_per_wallet:     u128,
    creator:            address,
    xpectra:            address,
    gtd_wallet_cap:     u128,
    fcfs_wallet_cap:    u128,
    public_wallet_cap:  u128
  ): address {
    assert_address(creator)
    assert_address(xpectra)
    require(max_supply > 0, "xuperfactory: invalid supply")
    require(value >= self.launch_fee, "xuperfactory: launch fee not paid")

    let xlist_addr = deploy(XLIST_BYTECODE)
    require(is_address(xlist_addr) && xlist_addr != 0, "xuperfactory: xlist deploy failed")

    let coll_addr = deploy(XCOLLECTION_BYTECODE)
    require(is_address(coll_addr) && coll_addr != 0, "xuperfactory: collection deploy failed")

    call(coll_addr, "init", name, symbol, unrevealed_uri, max_supply, royalty_bps,
         max_per_wallet, self.platform_wallet, creator, xlist_addr, xpectra,
         gtd_wallet_cap, fcfs_wallet_cap, public_wallet_cap)

    // the xlist operator is this factory at deploy, so init is authorized here.
    // set_operator hands whitelist control to the creator.
    call(xlist_addr, "init", coll_addr)
    call(xlist_addr, "set_operator", creator)

    self.collections[self.count] = coll_addr
    self.xlists[self.count]      = xlist_addr
    self.xlist_of[coll_addr]     = xlist_addr
    self.count += 1

    let nb: u128 = self.fee_balance + self.launch_fee
    require(nb >= self.fee_balance, "xuperfactory: fee overflow")
    self.fee_balance = nb

    if value > self.launch_fee {
      let refund = value - self.launch_fee
      let rok: bool = transfer(caller, refund)
      require(rok, "xuperfactory: refund failed")
    }

    return coll_addr
  }

  fn transfer_ownership(new_owner: address): bool {
    only_owner()
    assert_address(new_owner)
    self.owner = new_owner
    return true
  }

  // platform wallet applied to every new collection
  fn set_platform_wallet(new_wallet: address): bool {
    only_owner()
    assert_address(new_wallet)
    self.platform_wallet = new_wallet
    return true
  }

  // zero is allowed and makes launching free again.
  fn set_launch_fee(new_fee: u128): bool {
    only_owner()
    self.launch_fee = new_fee
    return true
  }

  // zero the balance before the transfer.
  fn withdraw(): bool {
    require(caller == self.owner || caller == self.platform_wallet, "xuperfactory: not authorized")
    let amount = self.fee_balance
    require(amount > 0, "xuperfactory: nothing to withdraw")
    self.fee_balance = 0
    let ok: bool = transfer(self.platform_wallet, amount)
    require(ok, "xuperfactory: withdraw transfer failed")
    return true
  }

  view fn get_launch_fee(): u128 {
    return self.launch_fee
  }

  view fn get_fee_balance(): u128 {
    return self.fee_balance
  }

  view fn get_collection(idx: u128): address {
    return self.collections[idx]
  }

  view fn get_xlist(idx: u128): address {
    return self.xlists[idx]
  }

  view fn get_xlist_for_collection(coll: address): address {
    return self.xlist_of[coll]
  }

  view fn get_count(): u128 {
    return self.count
  }

  view fn get_owner(): address {
    return self.owner
  }

  view fn get_platform_wallet(): address {
    return self.platform_wallet
  }
}
