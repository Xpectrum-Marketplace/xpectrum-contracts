// Xmarket: the Xpectrum secondary marketplace.
// Trades any XNS-1 contract: fixed-price listings, single-token offers, collection-wide offers.
// Royalty is read from the token contract and paid at settlement. Fee is 2.5%.
// Proceeds are never pushed. They are credited to the recipient and claimed later with claim_proceeds.
// u128 cannot hold -1, so a collection offer is marked by the offer_is_collection flag rather than a token_id sentinel.
// A collection offer carries a quantity. offer_amount is the price per unit and the escrow is amount * quantity, so an accept settles one unit and a cancel refunds the rest.
// standard_mode is set per collection by the owner. A flagged collection is checked with owner_of + get_approved instead of is_approved_or_owner, which lets contracts shaped like ERC-721 trade here unchanged. That lane has no operator support.
// Neither lane lets a caller buy their own listing or accept their own offer.
// sale| carries listing ids and osale| carries offer ids. They are separate types because an id means a different thing in each.
//
// get_offer >> offer_id | offerer | nft_contract | token_id | offer_is_collection | amount | quantity | expires_epoch | active

contract Xmarket_v3 {

  const MARKETPLACE_FEE_BPS: u128 = 250
  const MAX_ROYALTY_BPS:     u128 = 1000
  const MAX_OFFER_DURATION:  u128 = 518400
  const MAX_OFFER_QUANTITY:  u128 = 100

  state {
    owner:         address
    listing_count: u128
    offer_count:   u128
    total_volume:  u128
    fee_balance:   u128
    reserve:       u128
    offer_reserve: u128

    pending_proceeds: map[address]u128

    listing_seller:   map[u128]address
    listing_contract: map[u128]address
    listing_token_id: map[u128]u128
    listing_price:    map[u128]u128
    listing_status:   map[u128]u128
    listing_epoch:    map[u128]u128

    offer_offerer:       map[u128]address
    offer_contract:      map[u128]address
    offer_token_id:      map[u128]u128
    offer_is_collection: map[u128]u128
    // price per unit, so the escrow is offer_amount * offer_quantity
    offer_amount:        map[u128]u128
    offer_expires:       map[u128]u128
    offer_active:        map[u128]u128
    // remaining units (single-token offers: 1)
    offer_quantity:      map[u128]u128

    // 1 = universal-check collection (owner_of + get_approved instead of
    // is_approved_or_owner). Owner-set at onboarding; default 0 = XNS-1 mode.
    standard_mode: map[address]u128

    // (listing_id + 1) sentinel; 0 = no active listing
    contract_token_listing: map[address]map[u128]u128

    // global active listing index (swap-and-pop)
    active_ids:   map[u128]u128
    active_pos:   map[u128]u128
    active_count: u128

    // per-collection active listing index (swap-and-pop)
    coll_ids:   map[address]map[u128]u128
    coll_pos:   map[address]map[u128]u128
    coll_count: map[address]u128

    event_log:       map[u128]string
    event_log_count: u128
  }

  constructor() {
    self.owner = caller
  }

  private fn only_owner() {
    require(caller == self.owner, "xmarket: not owner")
  }

  private fn _index_add(listing_id: u128, nft_contract: address) {
    let gidx: u128 = self.active_count
    self.active_ids[gidx]       = listing_id
    self.active_pos[listing_id] = gidx
    self.active_count += 1

    let cidx: u128 = self.coll_count[nft_contract]
    self.coll_ids[nft_contract][cidx]       = listing_id
    self.coll_pos[nft_contract][listing_id] = cidx
    self.coll_count[nft_contract] += 1
  }

  private fn _index_remove(listing_id: u128, nft_contract: address) {
    require(self.active_count >= 1, "xmarket: empty active index")
    let gpos: u128  = self.active_pos[listing_id]
    let glast: u128 = self.active_count - 1
    if gpos != glast {
      let last_id: u128 = self.active_ids[glast]
      self.active_ids[gpos]    = last_id
      self.active_pos[last_id] = gpos
    }
    self.active_ids[glast]      = 0
    self.active_pos[listing_id] = 0
    self.active_count = glast

    require(self.coll_count[nft_contract] >= 1, "xmarket: empty coll index")
    let cpos: u128  = self.coll_pos[nft_contract][listing_id]
    let clast: u128 = self.coll_count[nft_contract] - 1
    if cpos != clast {
      let clast_id: u128 = self.coll_ids[nft_contract][clast]
      self.coll_ids[nft_contract][cpos]     = clast_id
      self.coll_pos[nft_contract][clast_id] = cpos
    }
    self.coll_ids[nft_contract][clast]      = 0
    self.coll_pos[nft_contract][listing_id] = 0
    self.coll_count[nft_contract] = clast
  }

  private fn _log(entry: string) {
    self.event_log[self.event_log_count] = entry
    self.event_log_count += 1
  }

  private fn _credit(recipient: address, amount: u128) {
    let np: u128 = self.pending_proceeds[recipient] + amount
    require(np >= self.pending_proceeds[recipient], "xmarket: proceeds overflow")
    self.pending_proceeds[recipient] = np
  }

  // Ownership/approval gate. XNS-1 collections (default) answer the rich
  // is_approved_or_owner (owner OR per-token approval OR operator). Flagged
  // standard-mode collections lack that fn, and calling a missing fn reverts
  // the whole tx, so they are checked via the two universal ERC-721-shaped
  // reads instead (owner OR per-token approval; operators unsupported).
  // Reverts unless addr may move token_id; returns 1 otherwise.
  private fn _check_approved_or_owner(nft_contract: address, token_id: u128, addr: address): u128 {
    if self.standard_mode[nft_contract] == 1 {
      let current_owner = call(nft_contract, "owner_of", token_id)
      if addr == current_owner { return 1 }
      let approved_addr = call(nft_contract, "get_approved", token_id)
      require(addr == approved_addr, "xmarket: not approved or owner")
      return 1
    }
    let approved = call(nft_contract, "is_approved_or_owner", token_id, addr)
    require(approved == 1, "xmarket: not approved or owner")
    return 1
  }

  // Strict ownership gate for offer accepts: proceeds are credited to the caller,
  // so the caller must BE the current owner (an approved/operator caller would be
  // paid for someone else's token if the NFT contract's transfer_from were lax
  // about the from param). owner_of is universal, so this
  // needs no standard-mode branch. Reverts unless addr owns token_id.
  private fn _check_is_owner(nft_contract: address, token_id: u128, addr: address): u128 {
    let current_owner = call(nft_contract, "owner_of", token_id)
    require(addr == current_owner, "xmarket: not token owner")
    return 1
  }

  private fn _settle(listing_id: u128, buyer: address) {
    let nft_contract = self.listing_contract[listing_id]
    let token_id     = self.listing_token_id[listing_id]
    let price        = self.listing_price[listing_id]
    let seller       = self.listing_seller[listing_id]

    let creator      = call(nft_contract, "creator_of",  token_id)
    let royalty_bps  = call(nft_contract, "royalty_of",  token_id)
    let safe_royalty = royalty_bps
    if safe_royalty > MAX_ROYALTY_BPS { safe_royalty = MAX_ROYALTY_BPS }

    let fee        = price * MARKETPLACE_FEE_BPS / 10000
    let royalty    = price * safe_royalty / 10000
    require(fee + royalty <= price, "xmarket: fee+royalty exceed price")
    let seller_cut = price - fee - royalty

    _credit(seller, seller_cut)
    _credit(creator, royalty)
    let nfb: u128 = self.fee_balance + fee
    require(nfb >= self.fee_balance, "xmarket: fee overflow")
    self.fee_balance = nfb

    require(self.reserve >= price, "xmarket: reserve underflow")
    self.reserve -= price
    let ntv: u128 = self.total_volume + price
    require(ntv >= self.total_volume, "xmarket: volume overflow")
    self.total_volume = ntv

    self.listing_status[listing_id]                     = 2
    self.contract_token_listing[nft_contract][token_id] = 0
    _index_remove(listing_id, nft_contract)

    let moved: bool = call(nft_contract, "transfer_from", seller, buyer, token_id)
    require(moved, "xmarket: nft transfer failed")

    let entry = concat("sale|", to_string(listing_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(buyer))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(seller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(price))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
  }

  // =============================================================
  // Listing
  // =============================================================

  fn list_nft(nft_contract: address, token_id: u128, price: u128): u128 {
    require(is_address(nft_contract) && nft_contract != 0, "xmarket: invalid contract")
    require(price > 0, "xmarket: price > 0 required")
    require(self.contract_token_listing[nft_contract][token_id] == 0, "xmarket: already listed")

    let ok = _check_approved_or_owner(nft_contract, token_id, caller)

    let id: u128 = self.listing_count
    self.listing_seller[id]   = caller
    self.listing_contract[id] = nft_contract
    self.listing_token_id[id] = token_id
    self.listing_price[id]    = price
    self.listing_status[id]   = 1
    self.listing_epoch[id]    = epoch
    self.listing_count += 1

    self.contract_token_listing[nft_contract][token_id] = id + 1
    _index_add(id, nft_contract)

    let entry = concat("list|", to_string(id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(price))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return id
  }

  fn cancel_listing(listing_id: u128): bool {
    require(listing_id < self.listing_count, "xmarket: bad listing id")
    require(self.listing_status[listing_id] == 1, "xmarket: not active")
    require(caller == self.listing_seller[listing_id] || caller == self.owner, "xmarket: not seller")

    let nft_contract = self.listing_contract[listing_id]
    let token_id     = self.listing_token_id[listing_id]

    self.listing_status[listing_id]                     = 0
    self.contract_token_listing[nft_contract][token_id] = 0
    _index_remove(listing_id, nft_contract)

    let entry = concat("cancel|", to_string(listing_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  fn buy_nft(listing_id: u128): bool {
    require(listing_id < self.listing_count, "xmarket: bad listing id")
    require(self.listing_status[listing_id] == 1, "xmarket: not active")
    require(caller != self.listing_seller[listing_id], "xmarket: cannot buy own listing")

    let price = self.listing_price[listing_id]
    require(value >= price, "xmarket: insufficient payment")

    let nr: u128 = self.reserve + price
    require(nr >= self.reserve, "xmarket: reserve overflow")
    self.reserve = nr
    if value > price {
      let rok: bool = transfer(caller, value - price)
      require(rok, "xmarket: refund failed")
    }

    _settle(listing_id, caller)
    return true
  }

  // =============================================================
  // Offers
  // =============================================================

  fn make_offer(nft_contract: address, token_id: u128, duration_epochs: u128): u128 {
    require(is_address(nft_contract) && nft_contract != 0, "xmarket: invalid contract")
    require(value > 0, "xmarket: no value sent")
    require(duration_epochs > 0 && duration_epochs <= MAX_OFFER_DURATION, "xmarket: bad duration")

    let id: u128 = self.offer_count
    self.offer_offerer[id]       = caller
    self.offer_contract[id]      = nft_contract
    self.offer_token_id[id]      = token_id
    self.offer_is_collection[id] = 0
    self.offer_amount[id]        = value
    self.offer_expires[id]       = epoch + duration_epochs
    self.offer_active[id]        = 1
    self.offer_quantity[id]      = 1
    self.offer_count += 1
    let nor: u128 = self.offer_reserve + value
    require(nor >= self.offer_reserve, "xmarket: offer reserve overflow")
    self.offer_reserve = nor

    let entry = concat("offer|", to_string(id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(value))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return id
  }

  // quantity units at value/quantity OCT each; total escrow = value.
  // value must divide evenly so unit_price * quantity == value exactly.
  fn make_collection_offer(nft_contract: address, duration_epochs: u128, quantity: u128): u128 {
    require(is_address(nft_contract) && nft_contract != 0, "xmarket: invalid contract")
    require(value > 0, "xmarket: no value sent")
    require(duration_epochs > 0 && duration_epochs <= MAX_OFFER_DURATION, "xmarket: bad duration")
    require(quantity > 0 && quantity <= MAX_OFFER_QUANTITY, "xmarket: bad quantity")
    let unit_price: u128 = value / quantity
    require(unit_price > 0, "xmarket: unit price is zero")
    require(unit_price * quantity == value, "xmarket: value not divisible by quantity")

    let id: u128 = self.offer_count
    self.offer_offerer[id]       = caller
    self.offer_contract[id]      = nft_contract
    self.offer_token_id[id]      = 0
    self.offer_is_collection[id] = 1
    self.offer_amount[id]        = unit_price
    self.offer_expires[id]       = epoch + duration_epochs
    self.offer_active[id]        = 1
    self.offer_quantity[id]      = quantity
    self.offer_count += 1
    let nor: u128 = self.offer_reserve + value
    require(nor >= self.offer_reserve, "xmarket: offer reserve overflow")
    self.offer_reserve = nor

    let entry = concat("coffer|", to_string(id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(unit_price))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(quantity))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return id
  }

  fn cancel_offer(offer_id: u128): bool {
    require(offer_id < self.offer_count, "xmarket: bad offer id")
    require(self.offer_active[offer_id] == 1, "xmarket: not active")
    require(caller == self.offer_offerer[offer_id], "xmarket: not offerer")

    // refund the remaining escrow: unit price * units not yet accepted.
    // remaining only ever decreases, so the product is bounded by the
    // originally escrowed value and cannot overflow.
    let remaining: u128 = self.offer_quantity[offer_id]
    require(remaining > 0, "xmarket: offer exhausted")
    let amount: u128 = self.offer_amount[offer_id] * remaining
    self.offer_active[offer_id]   = 0
    self.offer_quantity[offer_id] = 0
    require(self.offer_reserve >= amount, "xmarket: offer reserve underflow")
    self.offer_reserve -= amount
    _credit(caller, amount)

    let entry = concat("cancel_offer|", to_string(offer_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  private fn _do_accept_offer(offer_id: u128, token_id: u128, seller: address) {
    let nft_contract = self.offer_contract[offer_id]
    let price        = self.offer_amount[offer_id]
    let buyer        = self.offer_offerer[offer_id]
    require(seller != buyer, "xmarket: cannot accept own offer")

    // settle one unit: decrement remaining, deactivate on the last one.
    let remaining: u128 = self.offer_quantity[offer_id]
    require(remaining >= 1, "xmarket: offer exhausted")
    let remaining_after: u128 = remaining - 1
    self.offer_quantity[offer_id] = remaining_after
    if remaining == 1 { self.offer_active[offer_id] = 0 }
    require(self.offer_reserve >= price, "xmarket: offer reserve underflow")
    self.offer_reserve -= price

    // The sold token may sit in an active listing, so close it and log the cancel
    // (status 0 = closed-without-listing-sale; the trade itself is the osale below).
    let sentinel = self.contract_token_listing[nft_contract][token_id]
    if sentinel != 0 {
      let lid: u128 = sentinel - 1
      if self.listing_status[lid] == 1 {
        self.listing_status[lid]                            = 0
        self.contract_token_listing[nft_contract][token_id] = 0
        _index_remove(lid, nft_contract)
        let centry = concat("cancel|", to_string(lid))
        centry = concat(centry, "|")
        centry = concat(centry, to_string(seller))
        centry = concat(centry, "|")
        centry = concat(centry, to_string(epoch))
        _log(centry)
      }
    }

    let creator      = call(nft_contract, "creator_of", token_id)
    let royalty_bps  = call(nft_contract, "royalty_of",  token_id)
    let safe_royalty = royalty_bps
    if safe_royalty > MAX_ROYALTY_BPS { safe_royalty = MAX_ROYALTY_BPS }
    let fee        = price * MARKETPLACE_FEE_BPS / 10000
    let royalty    = price * safe_royalty / 10000
    require(fee + royalty <= price, "xmarket: fee+royalty exceed price")
    let seller_cut = price - fee - royalty

    _credit(seller, seller_cut)
    _credit(creator, royalty)
    let nfb: u128 = self.fee_balance + fee
    require(nfb >= self.fee_balance, "xmarket: fee overflow")
    self.fee_balance = nfb
    let ntv: u128 = self.total_volume + price
    require(ntv >= self.total_volume, "xmarket: volume overflow")
    self.total_volume = ntv

    let moved: bool = call(nft_contract, "transfer_from", seller, buyer, token_id)
    require(moved, "xmarket: nft transfer failed")

    // sale| carries listing ids, osale| carries offer ids.
    let entry = concat("osale|", to_string(offer_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(buyer))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(seller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(price))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(remaining_after))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
  }

  fn accept_offer(offer_id: u128): bool {
    require(offer_id < self.offer_count, "xmarket: bad offer id")
    require(self.offer_active[offer_id] == 1, "xmarket: not active")
    require(epoch <= self.offer_expires[offer_id], "xmarket: offer expired")
    require(self.offer_is_collection[offer_id] == 0, "xmarket: use accept_collection_offer")

    let token_id = self.offer_token_id[offer_id]
    let nft_contract = self.offer_contract[offer_id]
    let ok = _check_is_owner(nft_contract, token_id, caller)

    _do_accept_offer(offer_id, token_id, caller)
    return true
  }

  fn accept_collection_offer(offer_id: u128, token_id: u128): bool {
    require(offer_id < self.offer_count, "xmarket: bad offer id")
    require(self.offer_active[offer_id] == 1, "xmarket: not active")
    require(epoch <= self.offer_expires[offer_id], "xmarket: offer expired")
    require(self.offer_is_collection[offer_id] == 1, "xmarket: not a collection offer")

    let nft_contract = self.offer_contract[offer_id]
    let ok = _check_is_owner(nft_contract, token_id, caller)

    _do_accept_offer(offer_id, token_id, caller)
    return true
  }

  // =============================================================
  // Proceeds / admin
  // =============================================================

  fn claim_proceeds(): u128 {
    let amount = self.pending_proceeds[caller]
    require(amount > 0, "xmarket: nothing to claim")
    self.pending_proceeds[caller] = 0
    let ok: bool = transfer(caller, amount)
    require(ok, "xmarket: transfer failed")
    return amount
  }

  fn withdraw_fees(): u128 {
    only_owner()
    let amount = self.fee_balance
    require(amount > 0, "xmarket: no fees")
    self.fee_balance = 0
    let ok: bool = transfer(self.owner, amount)
    require(ok, "xmarket: transfer failed")
    return amount
  }

  fn transfer_ownership(new_owner: address): bool {
    only_owner()
    require(is_address(new_owner) && new_owner != 0, "xmarket: invalid address")
    self.owner = new_owner
    return true
  }

  // Flip a collection into (1) or out of (0) standard mode. Done once at
  // onboarding for foreign ERC-721-shaped contracts (owner_of + get_approved
  // must exist); XNS-1 collections stay at the default 0.
  fn set_standard_mode(nft_contract: address, mode: u128): bool {
    only_owner()
    require(is_address(nft_contract) && nft_contract != 0, "xmarket: invalid contract")
    require(mode <= 1, "xmarket: mode is 0 or 1")
    self.standard_mode[nft_contract] = mode

    let entry = concat("stdmode|", to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(mode))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  // =============================================================
  // Views: single item
  // =============================================================

  view fn get_listing(listing_id: u128): string {
    require(listing_id < self.listing_count, "xmarket: bad listing id")
    let out = to_string(listing_id)
    out = concat(out, "|")
    out = concat(out, to_string(self.listing_seller[listing_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.listing_contract[listing_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.listing_token_id[listing_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.listing_price[listing_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.listing_status[listing_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.listing_epoch[listing_id]))
    return out
  }

  view fn get_offer(offer_id: u128): string {
    require(offer_id < self.offer_count, "xmarket: bad offer id")
    let out = to_string(offer_id)
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_offerer[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_contract[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_token_id[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_is_collection[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_amount[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_expires[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_active[offer_id]))
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_quantity[offer_id]))
    return out
  }

  view fn get_offer_quantity(offer_id: u128): u128 {
    require(offer_id < self.offer_count, "xmarket: bad offer id")
    return self.offer_quantity[offer_id]
  }

  view fn get_standard_mode(nft_contract: address): u128 {
    return self.standard_mode[nft_contract]
  }

  view fn get_token_listing(nft_contract: address, token_id: u128): u128 {
    return self.contract_token_listing[nft_contract][token_id]
  }

  view fn get_pending_proceeds(addr: address): u128 {
    return self.pending_proceeds[addr]
  }

  view fn get_listing_count():  u128 { return self.listing_count }
  view fn get_offer_count():    u128 { return self.offer_count }
  view fn get_active_count():   u128 { return self.active_count }
  view fn get_total_volume():   u128 { return self.total_volume }
  view fn get_fee_balance():    u128 { return self.fee_balance }
  view fn get_reserve():        u128 { return self.reserve }
  view fn get_offer_reserve():  u128 { return self.offer_reserve }
  view fn get_owner():          address { return self.owner }

  view fn get_market_info(): string {
    let out = to_string(self.listing_count)
    out = concat(out, "|")
    out = concat(out, to_string(self.offer_count))
    out = concat(out, "|")
    out = concat(out, to_string(self.active_count))
    out = concat(out, "|")
    out = concat(out, to_string(self.total_volume))
    out = concat(out, "|")
    out = concat(out, to_string(self.fee_balance))
    out = concat(out, "|")
    out = concat(out, to_string(self.event_log_count))
    return out
  }

  // =============================================================
  // Views: paginated
  // =============================================================

  view fn get_listings_page(offset: u128, limit: u128): string {
    let total = self.active_count
    let out = to_string(total)
    if total == 0 { return out }
    let safe_limit = limit
    if safe_limit > 100 { safe_limit = 100 }
    let end = offset + safe_limit
    if end > total { end = total }
    if offset >= end { return out }
    let n = end - offset
    let i = 0
    for i in 0..n {
      let lid = self.active_ids[offset + i]
      out = concat(out, "~")
      out = concat(out, to_string(lid))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_seller[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_contract[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_token_id[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_price[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_epoch[lid]))
    }
    return out
  }

  view fn get_listings_for_collection(nft_contract: address, offset: u128, limit: u128): string {
    let total = self.coll_count[nft_contract]
    let out = to_string(total)
    if total == 0 { return out }
    let safe_limit = limit
    if safe_limit > 100 { safe_limit = 100 }
    let end = offset + safe_limit
    if end > total { end = total }
    if offset >= end { return out }
    let n = end - offset
    let i = 0
    for i in 0..n {
      let lid = self.coll_ids[nft_contract][offset + i]
      out = concat(out, "~")
      out = concat(out, to_string(lid))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_seller[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_token_id[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_price[lid]))
      out = concat(out, "|")
      out = concat(out, to_string(self.listing_epoch[lid]))
    }
    return out
  }

  view fn get_event_log(from: u128, count: u128): string {
    let total = self.event_log_count
    let out = to_string(total)
    if total == 0 { return out }
    let safe_count = count
    if safe_count > 50 { safe_count = 50 }
    let end = from + safe_count
    if end > total { end = total }
    if from >= end { return out }
    let n = end - from
    let i = 0
    for i in 0..n {
      out = concat(out, "~")
      out = concat(out, self.event_log[from + i])
    }
    return out
  }
}

