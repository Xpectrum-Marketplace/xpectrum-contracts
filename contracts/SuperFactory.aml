// SuperFactory >> deploys a fully linked Xcollection v3 + Xlist pair in one tx
// Mirrors XcollectionFactory params minus xlist (auto-deployed and linked here)

contract SuperFactory {

  const XCOLLECTION_BYTECODE: string = ""
  const XLIST_BYTECODE:       string = ""

  state {
    owner:       address
    count:       int
    collections: map[int]address
    xlists:      map[int]address
    xlist_of:    map[address]address
  }

  constructor() {
    self.owner = caller
    self.count = 0
  }

  private fn only_owner() {
    require(caller == self.owner, "superfactory: not owner")
  }

  // p1=name p2=symbol p3=unrevealed_uri p4=max_supply p5=royalty_bps p6=max_per_wallet
  // p7=xpectrum_addr p8=creator p9=genesis p10=gtd_wallet p11=fcfs_wallet p12=pub_wallet
  fn create_collection(
    p1:  string,
    p2:  string,
    p3:  string,
    p4:  int,
    p5:  int,
    p6:  int,
    p7:  address,
    p8:  address,
    p9:  address,
    p10: int,
    p11: int,
    p12: int
  ): address {
    // Permissionless by design: any creator deploys their own collection through the
    // wizard, signing + paying gas from their OWN wallet. The factory holds no funds and
    // grants no privilege -- it deploys two contracts and hands ownership to the creator
    // (p8). Was only_owner(), a vestige of the old platform-signer deploy path; that gate
    // made every non-platform creator's create_collection revert with "not owner".
    // transfer_ownership stays only_owner.

    let xlist_addr = deploy(XLIST_BYTECODE)
    require(is_address(xlist_addr) && xlist_addr != 0, "superfactory: xlist deploy failed")

    let coll_addr = deploy(XCOLLECTION_BYTECODE)
    require(is_address(coll_addr) && coll_addr != 0, "superfactory: collection deploy failed")

    // init(name, symbol, unrevealed_uri, max_supply, royalty_bps, max_per_wallet,
    //      xpectrum_addr, creator, xlist, genesis, gtd_wallet, fcfs_wallet, pub_wallet)
    call(coll_addr, "init", p1, p2, p3, p4, p5, p6, p7, p8, xlist_addr, p9, p10, p11, p12)

    // init xlist bound to the newly deployed collection, then hand the xlist
    // operator to the creator (p8) so they can manage their own whitelist.
    // (init requires only_operator; at deploy the operator is this factory, so
    // both calls are authorized; set_operator then transfers it to the creator.)
    call(xlist_addr, "init", coll_addr)
    call(xlist_addr, "set_operator", p8)

    self.collections[self.count] = coll_addr
    self.xlists[self.count]      = xlist_addr
    self.xlist_of[coll_addr]     = xlist_addr
    self.count += 1

    return coll_addr
  }

  fn transfer_ownership(new_owner: address): bool {
    only_owner()
    require(is_address(new_owner) && new_owner != 0, "superfactory: invalid address")
    self.owner = new_owner
    return true
  }

  view fn get_collection(idx: int): address {
    return self.collections[idx]
  }

  view fn get_xlist(idx: int): address {
    return self.xlists[idx]
  }

  view fn get_xlist_for_collection(coll: address): address {
    return self.xlist_of[coll]
  }

  view fn get_count(): int {
    return self.count
  }

  view fn get_owner(): address {
    return self.owner
  }
}
