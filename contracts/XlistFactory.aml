// XlistFactory >> deploys Xlist instances for collections
// call create_xlist(collection_addr) to deploy + initialize in one tx

contract XlistFactory {

  const XLIST_BYTECODE: string = ""

  state {
    owner:         address
    count:         int
    xlists:        map[int]address
    by_collection: map[address]address
  }

  constructor() {
    self.owner = caller
    self.count = 0
  }

  private fn only_owner() {
    require(caller == self.owner, "xlistfactory: not owner")
  }

  fn create_xlist(collection: address): address {
    only_owner()
    require(is_address(collection) && collection != 0, "xlistfactory: invalid collection")

    let xlist_addr = deploy(XLIST_BYTECODE)
    require(is_address(xlist_addr) && xlist_addr != 0, "xlistfactory: deploy failed")

    call(xlist_addr, "init", collection)

    self.xlists[self.count]        = xlist_addr
    self.by_collection[collection] = xlist_addr
    self.count += 1

    return xlist_addr
  }

  fn transfer_ownership(new_owner: address): bool {
    only_owner()
    require(is_address(new_owner) && new_owner != 0, "xlistfactory: invalid address")
    self.owner = new_owner
    return true
  }

  view fn get_xlist(idx: int): address {
    return self.xlists[idx]
  }

  view fn get_xlist_for_collection(collection: address): address {
    return self.by_collection[collection]
  }

  view fn get_count(): int {
    return self.count
  }

  view fn get_owner(): address {
    return self.owner
  }
}
