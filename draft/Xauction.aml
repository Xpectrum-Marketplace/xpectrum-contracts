// Xauction_v2 >> sealed-bid auctions.
//
// Bids are hidden while bidding is open and revealed to settle. Nothing is on
// chain to react to before the window shuts, so there is nothing to snipe.
//
// The token is escrowed here at creation. The auction can always deliver what
// it sold, so a winner who misses the settlement window did so by choice and
// the bond is forfeit on that basis. A voided auction returns the token to the
// seller on a pull, same as proceeds.
//
// Escrow of the BID is a flat bond, identical for every bidder, so the escrow
// amount leaks nothing about the bid and puts no ceiling on it. The winner pays
// the full price in a settlement window; miss it and the bond is forfeit to the
// seller and the token falls to the runner-up.
//
// min_bid is a public floor and is not the reserve. It is what the bond is
// sized against, so the cost of abandoning a winning bid tracks the size of the
// auction. The reserve stays committed and hidden.
//
// First price. The winner pays their own bid. Second price would let a seller
// shill just under the winner to inflate the take, undetectably, because the
// bids are sealed.
//
// Commitment is sha256 over a domain-separated preimage with the blinding
// first. The blinding carries all of the hiding: an unblinded or guessable
// blinding is brute-forced over the price range in seconds.
//
// Phases are epoch-driven: commit -> reveal -> settle.

contract Xauction_v2 {

  const MARKETPLACE_FEE_BPS: u128 = 250
  const MAX_ROYALTY_BPS:     u128 = 1000
  const MIN_BOND:            u128 = 100000
  const MAX_BOND:            u128 = 1000000000
  const BOND_FLOOR_BPS:      u128 = 500
  const MAX_MIN_BID:         u128 = 1000000000000000000000000
  const MAX_PHASE_EPOCHS:    u128 = 518400
  const MIN_PHASE_EPOCHS:    u128 = 1

  state {
    owner:          address
    auction_count:  u128
    fee_balance:    u128
    reserve:        u128
    total_volume:   u128

    pending_proceeds: map[address]u128

    auction_seller:   map[u128]address
    auction_contract: map[u128]address
    auction_token_id: map[u128]u128
    auction_bond:     map[u128]u128
    auction_min_bid:  map[u128]u128
    // 1 commit, 2 reveal, 3 awaiting payment, 4 settled, 5 void
    auction_status:   map[u128]u128
    // 1 while the token sits in this contract
    auction_asset_held: map[u128]u128

    auction_reserve_commit: map[u128]string
    auction_reserve_price:  map[u128]u128
    auction_reserve_shown:  map[u128]u128

    auction_commit_end: map[u128]u128
    auction_reveal_end: map[u128]u128
    auction_settle_end: map[u128]u128
    auction_settle_len: map[u128]u128

    auction_commits: map[u128]u128
    auction_reveals: map[u128]u128

    auction_top_bid:       map[u128]u128
    auction_top_bidder:    map[u128]address
    auction_second_bid:    map[u128]u128
    auction_second_bidder: map[u128]address

    auction_winner:  map[u128]address
    auction_price:   map[u128]u128
    auction_defaults: map[u128]u128

    bid_commit: map[u128]map[address]string
    bid_bond:   map[u128]map[address]u128
    bid_amount: map[u128]map[address]u128
    // 0 none, 1 committed, 2 revealed, 3 bond settled
    bid_state:  map[u128]map[address]u128

    standard_mode: map[address]u128

    event_log:       map[u128]string
    event_log_count: u128
  }

  constructor() {
    self.owner = caller
  }

  // =============================================================
  // Helpers
  // =============================================================

  private fn _log(entry: string) {
    self.event_log[self.event_log_count] = entry
    self.event_log_count += 1
  }

  private fn _credit(recipient: address, amount: u128) {
    let np: u128 = self.pending_proceeds[recipient] + amount
    require(np >= self.pending_proceeds[recipient], "xauction: proceeds overflow")
    self.pending_proceeds[recipient] = np
  }

  private fn _take(amount: u128) {
    let nr: u128 = self.reserve + amount
    require(nr >= self.reserve, "xauction: reserve overflow")
    self.reserve = nr
  }

  private fn _release(amount: u128) {
    require(self.reserve >= amount, "xauction: reserve underflow")
    self.reserve -= amount
  }

  // Blinding first, domain separated. Binding the contract, auction and bidder
  // stops a commitment being replayed elsewhere and kills precomputed tables.
  private fn _digest(auction_id: u128, bidder: address, amount: u128, blinding: string): string {
    let pre: string = concat("xauction-v2|", to_string(self_addr))
    pre = concat(pre, "|")
    pre = concat(pre, to_string(auction_id))
    pre = concat(pre, "|")
    pre = concat(pre, to_string(bidder))
    pre = concat(pre, "|")
    pre = concat(pre, blinding)
    pre = concat(pre, "|")
    pre = concat(pre, to_string(amount))
    return sha256(pre)
  }

  view fn preview_digest(auction_id: u128, bidder: address, amount: u128, blinding: string): string {
    return _digest(auction_id, bidder, amount, blinding)
  }

  private fn _check_is_owner(nft_contract: address, token_id: u128, addr: address): u128 {
    let current_owner = call(nft_contract, "owner_of", token_id)
    require(addr == current_owner, "xauction: not token owner")
    return 1
  }

  // Calling a missing fn reverts the whole tx, so flagged collections take the
  // universal reads instead of is_approved_or_owner.
  private fn _check_approved(nft_contract: address, token_id: u128, addr: address): u128 {
    if self.standard_mode[nft_contract] == 1 {
      let current_owner = call(nft_contract, "owner_of", token_id)
      if addr == current_owner { return 1 }
      let approved_addr = call(nft_contract, "get_approved", token_id)
      require(addr == approved_addr, "xauction: not approved or owner")
      return 1
    }
    let approved = call(nft_contract, "is_approved_or_owner", token_id, addr)
    require(approved == 1, "xauction: not approved or owner")
    return 1
  }

  // Custody is flagged before the call, so a repeat can never move the token
  // twice even if the outbound call itself is retried.
  private fn _send_asset(auction_id: u128, to: address) {
    require(self.auction_asset_held[auction_id] == 1, "xauction: asset not held")
    self.auction_asset_held[auction_id] = 0
    let nft_contract = self.auction_contract[auction_id]
    let token_id     = self.auction_token_id[auction_id]
    let moved: bool = call(nft_contract, "transfer_from", self_addr, to, token_id)
    require(moved, "xauction: nft transfer failed")
  }

  // =============================================================
  // Create
  // =============================================================

  fn create_auction(nft_contract: address, token_id: u128, reserve_commit: string,
                    min_bid: u128, bond: u128, commit_epochs: u128, reveal_epochs: u128,
                    settle_epochs: u128): u128 {
    require(bond >= MIN_BOND && bond <= MAX_BOND, "xauction: bad bond")
    require(min_bid <= MAX_MIN_BID, "xauction: floor too high")
    require(bond * 10000 >= min_bid * BOND_FLOOR_BPS, "xauction: bond too small for floor")
    require(commit_epochs >= MIN_PHASE_EPOCHS && commit_epochs <= MAX_PHASE_EPOCHS, "xauction: bad commit window")
    require(reveal_epochs >= MIN_PHASE_EPOCHS && reveal_epochs <= MAX_PHASE_EPOCHS, "xauction: bad reveal window")
    require(settle_epochs >= MIN_PHASE_EPOCHS && settle_epochs <= MAX_PHASE_EPOCHS, "xauction: bad settle window")
    require(len(reserve_commit) > 0, "xauction: no reserve commit")

    _check_is_owner(nft_contract, token_id, caller)
    _check_approved(nft_contract, token_id, self_addr)

    let id: u128 = self.auction_count
    self.auction_count += 1

    self.auction_seller[id]   = caller
    self.auction_contract[id] = nft_contract
    self.auction_token_id[id] = token_id
    self.auction_bond[id]     = bond
    self.auction_min_bid[id]  = min_bid
    self.auction_status[id]   = 1

    self.auction_reserve_commit[id] = reserve_commit
    self.auction_commit_end[id]     = epoch + commit_epochs
    self.auction_reveal_end[id]     = epoch + commit_epochs + reveal_epochs
    self.auction_settle_len[id]     = settle_epochs

    // Take custody last, after the state is consistent.
    let pulled: bool = call(nft_contract, "transfer_from", caller, self_addr, token_id)
    require(pulled, "xauction: escrow failed")
    self.auction_asset_held[id] = 1

    let entry = concat("acreate|", to_string(id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(min_bid))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(bond))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_commit_end[id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_reveal_end[id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return id
  }

  // Only while nobody has committed. Once a bond is posted the seller is
  // bound: the whole point of a sealed bid is that it cannot be withdrawn
  // from on either side.
  fn cancel_auction(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_status[auction_id] == 1, "xauction: not in commit phase")
    require(self.auction_commits[auction_id] == 0, "xauction: bids already committed")

    self.auction_status[auction_id] = 5
    _send_asset(auction_id, caller)

    let ev = concat("acancel|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(caller))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  // =============================================================
  // Commit
  // =============================================================

  fn commit_bid(auction_id: u128, commitment: string): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] == 1, "xauction: not in commit phase")
    require(epoch <= self.auction_commit_end[auction_id], "xauction: commit window closed")
    require(caller != self.auction_seller[auction_id], "xauction: seller cannot bid")
    require(self.bid_state[auction_id][caller] == 0, "xauction: already committed")
    require(len(commitment) > 0, "xauction: empty commitment")

    let bond: u128 = self.auction_bond[auction_id]
    require(value == bond, "xauction: bond must match exactly")
    _take(value)

    self.bid_commit[auction_id][caller] = commitment
    self.bid_bond[auction_id][caller]   = value
    self.bid_state[auction_id][caller]  = 1
    self.auction_commits[auction_id] += 1

    let entry = concat("acommit|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  // =============================================================
  // Reveal
  // =============================================================

  // A bid under the floor is a valid opening and gets its bond back, it just
  // does not rank. Rejecting it outright would strand the bond of anyone who
  // mistyped a number below the floor.
  fn reveal_bid(auction_id: u128, amount: u128, blinding: string): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] <= 2, "xauction: auction closed")
    require(epoch > self.auction_commit_end[auction_id], "xauction: reveal not open")
    require(epoch <= self.auction_reveal_end[auction_id], "xauction: reveal window closed")
    require(self.bid_state[auction_id][caller] == 1, "xauction: nothing to reveal")

    let expect: string = self.bid_commit[auction_id][caller]
    require(_digest(auction_id, caller, amount, blinding) == expect, "xauction: commit mismatch")

    self.auction_status[auction_id] = 2
    self.bid_amount[auction_id][caller] = amount
    self.bid_state[auction_id][caller]  = 2
    self.auction_reveals[auction_id] += 1

    if amount >= self.auction_min_bid[auction_id] {
      // strict >, so on a tie the earlier reveal keeps the lead
      if amount > self.auction_top_bid[auction_id] {
        self.auction_second_bid[auction_id]    = self.auction_top_bid[auction_id]
        self.auction_second_bidder[auction_id] = self.auction_top_bidder[auction_id]
        self.auction_top_bid[auction_id]       = amount
        self.auction_top_bidder[auction_id]    = caller
      } else {
        if amount > self.auction_second_bid[auction_id] {
          self.auction_second_bid[auction_id]    = amount
          self.auction_second_bidder[auction_id] = caller
        }
      }
    }

    let entry = concat("areveal|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(caller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(amount))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  fn reveal_reserve(auction_id: u128, reserve_price: u128, blinding: string): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_reserve_shown[auction_id] == 0, "xauction: reserve already revealed")
    require(epoch > self.auction_commit_end[auction_id], "xauction: reveal not open")
    require(epoch <= self.auction_reveal_end[auction_id], "xauction: reveal window closed")

    let expect: string = self.auction_reserve_commit[auction_id]
    require(_digest(auction_id, caller, reserve_price, blinding) == expect, "xauction: reserve mismatch")

    self.auction_reserve_price[auction_id] = reserve_price
    self.auction_reserve_shown[auction_id] = 1
    return true
  }

  // =============================================================
  // Finalize
  // =============================================================

  // A seller who never reveals the reserve is treated as reserve 0, so the
  // auction still settles and the seller cannot strand bidders' bonds.
  //
  // Early finalize needs every committer revealed AND the reserve shown.
  // Without the reserve it would resolve against a reserve of 0 while the
  // seller still had window left to open it.
  fn finalize(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] <= 2, "xauction: already finalized")

    if epoch <= self.auction_reveal_end[auction_id] {
      require(epoch > self.auction_commit_end[auction_id], "xauction: reveal not open")
      require(self.auction_commits[auction_id] > 0, "xauction: no bids")
      require(self.auction_reveals[auction_id] == self.auction_commits[auction_id], "xauction: reveals outstanding")
      require(self.auction_reserve_shown[auction_id] == 1, "xauction: reserve not revealed")
    }

    let top: u128 = self.auction_top_bid[auction_id]
    let res: u128 = self.auction_reserve_price[auction_id]

    if top == 0 {
      self.auction_status[auction_id] = 5
      let ev = concat("avoid|", to_string(auction_id))
      ev = concat(ev, "|no_bids|")
      ev = concat(ev, to_string(epoch))
      _log(ev)
      return true
    }
    if top < res {
      self.auction_status[auction_id] = 5
      let ev2 = concat("avoid|", to_string(auction_id))
      ev2 = concat(ev2, "|reserve_not_met|")
      ev2 = concat(ev2, to_string(epoch))
      _log(ev2)
      return true
    }

    self.auction_winner[auction_id] = self.auction_top_bidder[auction_id]
    self.auction_price[auction_id]  = top
    self.auction_status[auction_id] = 3
    self.auction_settle_end[auction_id] = epoch + self.auction_settle_len[auction_id]

    let entry = concat("afinal|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_top_bidder[auction_id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(top))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(self.auction_settle_end[auction_id]))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
    return true
  }

  // =============================================================
  // Settle
  // =============================================================

  private fn _payout(auction_id: u128, buyer: address, price: u128) {
    let nft_contract = self.auction_contract[auction_id]
    let token_id     = self.auction_token_id[auction_id]
    let seller       = self.auction_seller[auction_id]

    let creator     = call(nft_contract, "creator_of", token_id)
    let royalty_bps = call(nft_contract, "royalty_of", token_id)
    let safe_royalty = royalty_bps
    if safe_royalty > MAX_ROYALTY_BPS { safe_royalty = MAX_ROYALTY_BPS }

    let fee     = price * MARKETPLACE_FEE_BPS / 10000
    let royalty = price * safe_royalty / 10000
    require(fee + royalty <= price, "xauction: fee+royalty exceed price")
    let seller_cut = price - fee - royalty

    _credit(seller, seller_cut)
    _credit(creator, royalty)
    let nfb: u128 = self.fee_balance + fee
    require(nfb >= self.fee_balance, "xauction: fee overflow")
    self.fee_balance = nfb

    _release(price)
    let ntv: u128 = self.total_volume + price
    require(ntv >= self.total_volume, "xauction: volume overflow")
    self.total_volume = ntv

    self.auction_status[auction_id] = 4

    _send_asset(auction_id, buyer)

    let entry = concat("asettle|", to_string(auction_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(buyer))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(seller))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(nft_contract))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(token_id))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(price))
    entry = concat(entry, "|")
    entry = concat(entry, to_string(epoch))
    _log(entry)
  }

  // Winner pays. The bond is credited back here rather than refunded as change,
  // so proceeds stay pull-based.
  fn settle(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] == 3, "xauction: not awaiting payment")
    require(caller == self.auction_winner[auction_id], "xauction: not the winner")
    require(epoch <= self.auction_settle_end[auction_id], "xauction: settle window closed")

    let price: u128 = self.auction_price[auction_id]
    require(value >= price, "xauction: insufficient payment")
    _take(value)

    if value > price {
      _release(value - price)
      let rok: bool = transfer(caller, value - price)
      require(rok, "xauction: refund failed")
    }

    _payout(auction_id, caller, price)

    let bond: u128 = self.bid_bond[auction_id][caller]
    if bond > 0 {
      self.bid_bond[auction_id][caller]  = 0
      self.bid_state[auction_id][caller] = 3
      _release(bond)
      _credit(caller, bond)
    }
    return true
  }

  // Winner missed the window. Bond goes to the seller and the token falls to
  // the runner-up, who gets a fresh settle window. No runner-up means void and
  // the seller reclaims.
  fn default_winner(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(self.auction_status[auction_id] == 3, "xauction: not awaiting payment")
    require(epoch > self.auction_settle_end[auction_id], "xauction: settle window still open")

    let loser: address = self.auction_winner[auction_id]
    let bond: u128 = self.bid_bond[auction_id][loser]
    if bond > 0 {
      self.bid_bond[auction_id][loser]  = 0
      self.bid_state[auction_id][loser] = 3
      _release(bond)
      _credit(self.auction_seller[auction_id], bond)
    }
    self.auction_defaults[auction_id] += 1

    let ev = concat("adefault|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(loser))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bond))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)

    let runner: address = self.auction_second_bidder[auction_id]
    let runner_bid: u128 = self.auction_second_bid[auction_id]
    if runner_bid > 0 && runner_bid >= self.auction_reserve_price[auction_id] {
      self.auction_winner[auction_id] = runner
      self.auction_price[auction_id]  = runner_bid
      self.auction_second_bid[auction_id] = 0
      self.auction_settle_end[auction_id] = epoch + self.auction_settle_len[auction_id]

      let ev2 = concat("apromote|", to_string(auction_id))
      ev2 = concat(ev2, "|")
      ev2 = concat(ev2, to_string(runner))
      ev2 = concat(ev2, "|")
      ev2 = concat(ev2, to_string(runner_bid))
      ev2 = concat(ev2, "|")
      ev2 = concat(ev2, to_string(epoch))
      _log(ev2)
      return true
    }

    self.auction_status[auction_id] = 5
    let ev3 = concat("avoid|", to_string(auction_id))
    ev3 = concat(ev3, "|winner_defaulted|")
    ev3 = concat(ev3, to_string(epoch))
    _log(ev3)
    return true
  }

  // =============================================================
  // Asset return
  // =============================================================

  // Pull-based on purpose. Returning the token inside finalize would put a
  // cross-contract call in the path of everyone else's resolution.
  fn reclaim_asset(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    require(caller == self.auction_seller[auction_id], "xauction: not the seller")
    require(self.auction_status[auction_id] == 5, "xauction: auction not void")

    _send_asset(auction_id, caller)

    let ev = concat("areclaim|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(caller))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(self.auction_token_id[auction_id]))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  // =============================================================
  // Bonds and proceeds
  // =============================================================

  // Anyone who revealed gets their bond back once the auction is resolved.
  // A no-show who never revealed forfeits it to the seller: without that, a
  // committer could starve the auction for free.
  fn claim_bond(auction_id: u128): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    let st: u128 = self.auction_status[auction_id]
    require(st == 4 || st == 5, "xauction: auction not resolved")
    require(caller != self.auction_winner[auction_id] || st == 5, "xauction: winner settles instead")

    let bond: u128 = self.bid_bond[auction_id][caller]
    require(bond > 0, "xauction: no bond")
    require(self.bid_state[auction_id][caller] == 2, "xauction: did not reveal")

    self.bid_bond[auction_id][caller]  = 0
    self.bid_state[auction_id][caller] = 3
    _release(bond)
    _credit(caller, bond)

    let ev = concat("arefund|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(caller))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bond))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  fn slash_no_reveal(auction_id: u128, bidder: address): bool {
    require(auction_id < self.auction_count, "xauction: bad auction id")
    let st: u128 = self.auction_status[auction_id]
    require(st == 4 || st == 5, "xauction: auction not resolved")
    require(self.bid_state[auction_id][bidder] == 1, "xauction: bidder revealed")

    let bond: u128 = self.bid_bond[auction_id][bidder]
    require(bond > 0, "xauction: no bond")
    self.bid_bond[auction_id][bidder]  = 0
    self.bid_state[auction_id][bidder] = 3
    _release(bond)
    _credit(self.auction_seller[auction_id], bond)

    let ev = concat("aslash|", to_string(auction_id))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bidder))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(bond))
    ev = concat(ev, "|")
    ev = concat(ev, to_string(epoch))
    _log(ev)
    return true
  }

  fn claim_proceeds(): bool {
    let amount: u128 = self.pending_proceeds[caller]
    require(amount > 0, "xauction: nothing to claim")
    self.pending_proceeds[caller] = 0
    let ok: bool = transfer(caller, amount)
    require(ok, "xauction: payout failed")
    return true
  }

  // =============================================================
  // Admin
  // =============================================================

  fn set_standard_mode(nft_contract: address, flag: u128): bool {
    require(caller == self.owner, "xauction: not owner")
    self.standard_mode[nft_contract] = flag
    return true
  }

  fn withdraw_fees(to: address): bool {
    require(caller == self.owner, "xauction: not owner")
    let amount: u128 = self.fee_balance
    require(amount > 0, "xauction: no fees")
    self.fee_balance = 0
    let ok: bool = transfer(to, amount)
    require(ok, "xauction: withdraw failed")
    return true
  }

  // =============================================================
  // Views
  // =============================================================

  view fn get_version(): u128 {
    return 2
  }

  view fn get_auction(auction_id: u128): string {
    let s = concat(to_string(self.auction_status[auction_id]), "|")
    s = concat(s, to_string(self.auction_seller[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_contract[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_token_id[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_min_bid[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_bond[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_commit_end[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_reveal_end[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_settle_end[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_asset_held[auction_id]))
    return s
  }

  view fn get_result(auction_id: u128): string {
    let s = concat(to_string(self.auction_top_bid[auction_id]), "|")
    s = concat(s, to_string(self.auction_top_bidder[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_second_bid[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_second_bidder[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_winner[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_price[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_reserve_shown[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_reserve_price[auction_id]))
    return s
  }

  view fn get_participation(auction_id: u128): string {
    let s = concat(to_string(self.auction_commits[auction_id]), "|")
    s = concat(s, to_string(self.auction_reveals[auction_id]))
    s = concat(s, "|")
    s = concat(s, to_string(self.auction_defaults[auction_id]))
    return s
  }

  view fn get_bid(auction_id: u128, bidder: address): string {
    let s = concat(to_string(self.bid_state[auction_id][bidder]), "|")
    s = concat(s, to_string(self.bid_bond[auction_id][bidder]))
    s = concat(s, "|")
    s = concat(s, to_string(self.bid_amount[auction_id][bidder]))
    s = concat(s, "|")
    s = concat(s, self.bid_commit[auction_id][bidder])
    return s
  }

  view fn get_proceeds(who: address): u128 {
    return self.pending_proceeds[who]
  }

  view fn get_event(i: u128): string {
    return self.event_log[i]
  }

  view fn get_stats(): string {
    let s = concat(to_string(self.auction_count), "|")
    s = concat(s, to_string(self.event_log_count))
    s = concat(s, "|")
    s = concat(s, to_string(self.reserve))
    s = concat(s, "|")
    s = concat(s, to_string(self.fee_balance))
    s = concat(s, "|")
    s = concat(s, to_string(self.total_volume))
    return s
  }
}
